{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LiteDock",
  "version": "1.2.1",
  "identifier": "com.litedock.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LiteDock",
        "width": 1200,
        "height": 800,
        "minWidth": 940,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": ["resources/litedock-engine.tar", "resources/docker-cli/*"],
    "category": "DeveloperTool",
    "shortDescription": "Lightweight Docker container manager",
    "longDescription": "LiteDock is a lightweight, all-in-one Docker container manager for Windows. It runs the real Docker Engine inside a dedicated, minimal WSL2 distribution and presents a fast native UI that consumes the Docker Engine API.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "installer/nsis/hooks.nsi",
        "languages": ["English", "SpanishInternational"]
      }
    }
  },
  "plugins": {}
}
